# PostgreSQL is the primary FuelLead database.
POSTGRES_DB=fuellead
POSTGRES_USER=fuellead
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://fuellead:change-me@db:5432/fuellead

# Leave empty to run the built-in demo discovery without paid API calls.
CHECKO_API_KEY=
CHECKO_BASE_URL=https://api.checko.ru/v2
CHECKO_TIMEOUT_SECONDS=30

APP_TIMEZONE=Europe/Moscow
DISCOVERY_LIMIT_PER_CODE=10
VITE_API_BASE_URL=/api

