# PostgreSQL is the primary FuelLead database.
POSTGRES_DB=fuellead
POSTGRES_USER=fuellead
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://fuellead:change-me@db:5432/fuellead

# Leave empty to run the built-in demo discovery without paid API calls.
CHECKO_API_KEY=
# Optional comma-separated backup keys. The next key is used only when the current key is exhausted or rejected.
CHECKO_API_KEY_FALLBACKS=
CHECKO_BASE_URL=https://api.checko.ru/v2
CHECKO_TIMEOUT_SECONDS=30

APP_TIMEZONE=Europe/Moscow
DISCOVERY_LIMIT_PER_CODE=10
VITE_API_BASE_URL=/api

# Gmail API uses OAuth 2.0; a Google app password is not required.
OUTREACH_SENDER_EMAIL=artel.office8@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Do not store GMAIL_ACCESS_TOKEN: it expires quickly and is refreshed automatically.
GMAIL_TIMEOUT_SECONDS=30
