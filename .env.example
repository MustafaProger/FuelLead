# PostgreSQL is the primary FuelLead database.
POSTGRES_DB=fuellead
POSTGRES_USER=fuellead
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://fuellead:change-me@db:5432/fuellead

# Select demo, checko, okvedo, dadata, api_fns, or combined.
# auto uses configured providers; API-FNS is always the last quota fallback.
# Explicit api_fns also uses combined when primary providers are configured.
DISCOVERY_PROVIDER=demo

# Checko provider. Keep real keys only in the ignored local .env file.
CHECKO_API_KEY=
# Optional comma-separated backup keys. The next key is used only when the current key is exhausted or rejected.
CHECKO_API_KEY_FALLBACKS=
CHECKO_BASE_URL=https://api.checko.ru/v2
CHECKO_TIMEOUT_SECONDS=30

# Okvedo company search and cards.
OKVEDO_API_KEY=
OKVEDO_BASE_URL=https://okvedo.ru/api/v1
OKVEDO_TIMEOUT_SECONDS=30

# DaData suggestions (up to 20 per OKVED/region query) and company lookup.
DADATA_API_KEY=
# Used only to verify remaining.suggestions on a 403; never sent to suggestions.
DADATA_SECRET_KEY=
DADATA_BASE_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs
DADATA_TIMEOUT_SECONDS=30

# API-ФНС provider. Search filters only the primary OKVED. The contact filters are optional.
API_FNS_KEY=
API_FNS_BASE_URL=https://api-fns.ru/api
API_FNS_TIMEOUT_SECONDS=30
API_FNS_REQUIRE_PHONE=false
API_FNS_REQUIRE_EMAIL=false
# These two caps apply only to explicit search_scope=batch; the UI uses full search.
API_FNS_MAX_SEARCH_REQUESTS_PER_RUN=5
API_FNS_MAX_EGR_REQUESTS_PER_RUN=5

APP_TIMEZONE=Europe/Moscow
# Legacy batch size. Full search ignores this cap and uses provider page sizes.
DISCOVERY_LIMIT_PER_CODE=10
VITE_API_BASE_URL=/api

# Mail.ru passwords are encrypted before they reach PostgreSQL. Generate a local key with:
# docker compose run --rm backend python -m app.commands.generate_mail_credentials_key
# Copy the printed value only to the ignored local .env file. Never commit or rotate this
# key without first replacing the saved mailbox passwords through the UI.
MAIL_CREDENTIALS_ENCRYPTION_KEY=
MAIL_SMTP_TIMEOUT_SECONDS=30
MAIL_IMAP_TIMEOUT_SECONDS=30
MAIL_IMAP_WORKER_POLL_SECONDS=300
MAIL_IMAP_MAX_MESSAGES_PER_TICK=50

# Automatic outreach is disabled. Keep it disabled: campaigns require a fresh
# 10-minute snapshot and an explicit confirmation in the UI.
OUTREACH_AUTOMATIC_SEND_ENABLED=false
OUTREACH_CAMPAIGN_SIZE=500
OUTREACH_DAILY_LIMIT=500
# Set to 0 to disable the rolling-hour limit.
OUTREACH_HOURLY_LIMIT=0
OUTREACH_MIN_INTERVAL_SECONDS=10
# Set to 0 to disable the per-recipient-domain limit.
OUTREACH_MAX_PER_DOMAIN_PER_DAY=0
OUTREACH_WORKER_POLL_SECONDS=30
OUTREACH_SNAPSHOT_TTL_SECONDS=600
OUTREACH_MESSAGE_INTERVAL_MIN_SECONDS=60
OUTREACH_MESSAGE_INTERVAL_MAX_SECONDS=85
OUTREACH_ROUND_REST_MIN_MINUTES=77
OUTREACH_ROUND_REST_MAX_MINUTES=93
# Plain-text footer appended to every outreach email.
OUTREACH_OPT_OUT_TEXT=Если предложение неактуально, ответьте «Не писать», и мы исключим адрес из дальнейших обращений.

# Internal FuelLead access. Keep the real values only in the ignored local .env file.
FUELLEAD_AUTH_EMAIL=operator@example.com
FUELLEAD_AUTH_PASSWORD=change-me
FUELLEAD_AUTH_SESSION_SECRET=replace-with-a-long-random-secret
FUELLEAD_AUTH_COOKIE_DAYS=3650
# Set to true when FuelLead is served exclusively over HTTPS.
FUELLEAD_AUTH_COOKIE_SECURE=false
